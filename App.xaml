<Application x:Class="WhateverITPCCare.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             StartupUri="MainWindow.xaml">
    <Application.Resources>
        <ResourceDictionary>

            <!-- ===== Palette (Whatever IT "wolf / night" brand) ===== -->
            <Color x:Key="BgColor">#FF0B0E13</Color>
            <Color x:Key="CardColor">#FF141A24</Color>
            <Color x:Key="CardColor2">#FF1C2634</Color>
            <Color x:Key="AccentColor">#FFE8902B</Color>      <!-- wolf amber -->
            <SolidColorBrush x:Key="BgBrush" Color="{StaticResource BgColor}"/>
            <SolidColorBrush x:Key="CardBrush" Color="{StaticResource CardColor}"/>
            <SolidColorBrush x:Key="Card2Brush" Color="{StaticResource CardColor2}"/>
            <SolidColorBrush x:Key="AccentBrush" Color="{StaticResource AccentColor}"/>
            <SolidColorBrush x:Key="OnAccentBrush" Color="#FF14100A"/> <!-- dark text on amber -->
            <SolidColorBrush x:Key="TextBrush" Color="#FFF1F4FA"/>
            <SolidColorBrush x:Key="MutedBrush" Color="#FF93A1B5"/>
            <SolidColorBrush x:Key="GoodBrush" Color="#FF34C759"/>
            <SolidColorBrush x:Key="WarnBrush" Color="#FFFFB020"/>
            <SolidColorBrush x:Key="BadBrush" Color="#FFFF4D4F"/>

            <!-- ===== Wolf logo brushes ===== -->
            <LinearGradientBrush x:Key="WolfBrush" StartPoint="0,0" EndPoint="0,1">
                <GradientStop Color="#FFF4AE3E" Offset="0"/>
                <GradientStop Color="#FFE07E1E" Offset="1"/>
            </LinearGradientBrush>
            <SolidColorBrush x:Key="WolfDarkBrush" Color="#FF8A5212"/>
            <SolidColorBrush x:Key="WolfEyeBrush" Color="#FF9FF6FF"/>
            <SolidColorBrush x:Key="ScanArcBrush" Color="#FF2BD4D9"/>

            <!-- ===== Card ===== -->
            <Style x:Key="Card" TargetType="Border">
                <Setter Property="Background" Value="{StaticResource CardBrush}"/>
                <Setter Property="CornerRadius" Value="12"/>
                <Setter Property="Padding" Value="18"/>
                <Setter Property="Margin" Value="0,0,0,14"/>
            </Style>

            <!-- ===== Primary button ===== -->
            <Style x:Key="PrimaryButton" TargetType="Button">
                <Setter Property="Background" Value="{StaticResource AccentBrush}"/>
                <Setter Property="Foreground" Value="{StaticResource OnAccentBrush}"/>
                <Setter Property="FontWeight" Value="SemiBold"/>
                <Setter Property="FontSize" Value="14"/>
                <Setter Property="Padding" Value="18,10"/>
                <Setter Property="Cursor" Value="Hand"/>
                <Setter Property="BorderThickness" Value="0"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border Background="{TemplateBinding Background}" CornerRadius="8" Padding="{TemplateBinding Padding}">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
                <Style.Triggers>
                    <Trigger Property="IsMouseOver" Value="True">
                        <Setter Property="Background" Value="#FFF4AE3E"/>
                    </Trigger>
                    <Trigger Property="IsEnabled" Value="False">
                        <Setter Property="Background" Value="#FF2A3647"/>
                        <Setter Property="Foreground" Value="{StaticResource MutedBrush}"/>
                    </Trigger>
                </Style.Triggers>
            </Style>

            <!-- ===== Ghost button ===== -->
            <Style x:Key="GhostButton" TargetType="Button" BasedOn="{StaticResource PrimaryButton}">
                <Setter Property="Background" Value="{StaticResource Card2Brush}"/>
                <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
                <Style.Triggers>
                    <Trigger Property="IsMouseOver" Value="True">
                        <Setter Property="Background" Value="#FF26384C"/>
                    </Trigger>
                </Style.Triggers>
            </Style>

        </ResourceDictionary>
    </Application.Resources>
</Application>
