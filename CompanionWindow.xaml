<Window x:Class="WhateverITPCCare.CompanionWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Wolf" WindowStyle="None" AllowsTransparency="True"
        Background="Transparent" ShowInTaskbar="False" Topmost="True"
        ResizeMode="NoResize" SizeToContent="Manual"
        Width="240" Height="360" Left="80" Top="80">

    <!-- Option C: frame-by-frame sprites + contact shadow + mood light +
         perspective/rim for a stronger 3D read while staying pure WPF 2D. -->
    <Grid x:Name="Root">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Grid x:Name="SpriteBox" Grid.Row="1" Width="140"
              HorizontalAlignment="Center" VerticalAlignment="Bottom"
              RenderTransformOrigin="0.5,1.0" Cursor="Hand"
              MouseLeftButtonDown="OnWolfMouseDown"
              MouseLeftButtonUp="OnWolfMouseUp"
              MouseMove="OnWolfMouseMove"
              MouseRightButtonUp="OnWolfRightClick">
            <Grid.RenderTransform>
                <TransformGroup>
                    <ScaleTransform x:Name="Facing" ScaleX="1" ScaleY="1"/>
                    <ScaleTransform x:Name="Pulse" ScaleX="1" ScaleY="1" CenterX="70" CenterY="160"/>
                    <TranslateTransform x:Name="Bob" X="0" Y="0"/>
                    <RotateTransform x:Name="Tilt" Angle="0" CenterX="70" CenterY="160"/>
                    <SkewTransform x:Name="PerspSkew" AngleX="0" AngleY="0" CenterX="70" CenterY="160"/>
                </TransformGroup>
            </Grid.RenderTransform>

            <!-- Soft contact shadow under the feet -->
            <Image x:Name="ContactShadow" Width="110" Height="28"
                   HorizontalAlignment="Center" VerticalAlignment="Bottom"
                   Margin="0,0,0,-6" Opacity="0.55" IsHitTestVisible="False"
                   Stretch="Fill" RenderTransformOrigin="0.5,0.5">
                <Image.RenderTransform>
                    <ScaleTransform x:Name="ShadowScale" ScaleX="1" ScaleY="1"/>
                </Image.RenderTransform>
            </Image>

            <!-- Main character frame -->
            <Image x:Name="SpriteImg" Stretch="Uniform" Width="130"
                   HorizontalAlignment="Center" VerticalAlignment="Bottom"
                   Margin="0,0,0,8">
                <Image.Effect>
                    <DropShadowEffect x:Name="RimGlow" BlurRadius="14" ShadowDepth="0"
                                      Color="#FFE8C090" Opacity="0.35"/>
                </Image.Effect>
            </Image>

            <!-- Dynamic mood / key-light overlay -->
            <Ellipse x:Name="MoodLight" Width="90" Height="110"
                     HorizontalAlignment="Center" VerticalAlignment="Top"
                     Margin="0,18,0,0" IsHitTestVisible="False" Opacity="0.22">
                <Ellipse.Fill>
                    <RadialGradientBrush GradientOrigin="0.55,0.25" Center="0.5,0.4" RadiusX="0.7" RadiusY="0.7">
                        <GradientStop x:Name="MoodLightCenter" Color="#60FFE8C0" Offset="0"/>
                        <GradientStop Color="#00FFFFFF" Offset="1"/>
                    </RadialGradientBrush>
                </Ellipse.Fill>
            </Ellipse>

            <TextBlock x:Name="SleepZ" Text="z z Z" Foreground="#FF9FF6FF" FontSize="18"
                       FontWeight="Bold" FontFamily="Segoe UI" Visibility="Collapsed"
                       HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,8,10,0"
                       IsHitTestVisible="False"/>
        </Grid>
    </Grid>
</Window>
