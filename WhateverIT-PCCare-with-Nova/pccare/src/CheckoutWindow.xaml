<Window x:Class="WhateverITPCCare.CheckoutWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
        Title="Secure payment" Height="780" Width="520"
        WindowStartupLocation="CenterOwner"
        Background="#FF0E1621" Foreground="White" FontFamily="Segoe UI">
    <Grid Margin="4">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="16,14,16,10">
            <TextBlock x:Name="HeadLine" Text="Secure payment" FontSize="16" FontWeight="Bold"/>
            <TextBlock FontSize="12" Foreground="#FF8CA0B8" Margin="0,4,0,0" TextWrapping="Wrap"
                       Text="Complete your payment below. Your plan activates automatically the moment the payment is confirmed – no key to type."/>
        </StackPanel>

        <Border Grid.Row="1" Margin="12,0,12,0" CornerRadius="8" ClipToBounds="True">
            <wv2:WebView2 x:Name="Web"/>
        </Border>

        <Grid Grid.Row="2" Margin="16,10,16,14">
            <TextBlock x:Name="StatusLine" VerticalAlignment="Center" FontSize="12" Foreground="#FF8CA0B8"
                       Text="Waiting for payment…"/>
            <Button x:Name="PaidButton" HorizontalAlignment="Right" Content="I've completed payment"
                    Padding="12,6" Background="#FF2563EB" Foreground="White" BorderThickness="0"
                    Click="OnManualPaid" Cursor="Hand"/>
        </Grid>
    </Grid>
</Window>
