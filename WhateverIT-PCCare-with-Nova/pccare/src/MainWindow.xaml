<Window x:Class="WhateverITPCCare.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:h="clr-namespace:WhateverITPCCare.Helpers"
        Title="Whatever IT PC Care" Height="760" Width="1040"
        MinHeight="620" MinWidth="900"
        Icon="/Assets/wolf-logo.png"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource BgBrush}" Foreground="{StaticResource TextBrush}"
        FontFamily="Segoe UI">

    <Window.Resources>
        <h:StringToBrushConverter x:Key="ToBrush"/>
        <h:NullToVisibilityConverter x:Key="NullVis"/>
        <h:BoolToVisibilityConverter x:Key="BoolVis"/>

        <Style TargetType="TabItem">
            <Setter Property="Foreground" Value="{StaticResource MutedBrush}"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabItem">
                        <Border x:Name="b" Background="Transparent" Padding="18,10" Margin="0,0,6,0" CornerRadius="8">
                            <ContentPresenter ContentSource="Header" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="b" Property="Background" Value="{StaticResource AccentBrush}"/>
                                <Setter Property="Foreground" Value="{StaticResource OnAccentBrush}"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ===== Wolf "Scan PC" animations ===== -->
        <Storyboard x:Key="WolfScanLoop">
            <DoubleAnimation Storyboard.TargetName="ScanArcRotate" Storyboard.TargetProperty="Angle"
                             From="0" To="360" Duration="0:0:1.3" RepeatBehavior="Forever"/>
            <DoubleAnimation Storyboard.TargetName="WolfScanArc" Storyboard.TargetProperty="Opacity"
                             To="0.95" Duration="0:0:0.25"/>
            <DoubleAnimation Storyboard.TargetName="WolfRotate" Storyboard.TargetProperty="Angle"
                             From="-7" To="7" Duration="0:0:0.45" AutoReverse="True" RepeatBehavior="Forever"/>
            <DoubleAnimation Storyboard.TargetName="WolfScale" Storyboard.TargetProperty="ScaleX"
                             From="1" To="1.08" Duration="0:0:0.45" AutoReverse="True" RepeatBehavior="Forever"/>
            <DoubleAnimation Storyboard.TargetName="WolfScale" Storyboard.TargetProperty="ScaleY"
                             From="1" To="1.08" Duration="0:0:0.45" AutoReverse="True" RepeatBehavior="Forever"/>
        </Storyboard>

        <!-- One-shot "howl / pounce" when the scan finishes -->
        <Storyboard x:Key="WolfHowl">
            <DoubleAnimation Storyboard.TargetName="WolfScale" Storyboard.TargetProperty="ScaleX"
                             From="1" To="1.22" Duration="0:0:0.16" AutoReverse="True"/>
            <DoubleAnimation Storyboard.TargetName="WolfScale" Storyboard.TargetProperty="ScaleY"
                             From="1" To="1.22" Duration="0:0:0.16" AutoReverse="True"/>
            <DoubleAnimation Storyboard.TargetName="WolfLogo" Storyboard.TargetProperty="Opacity"
                             From="0.55" To="1" Duration="0:0:0.3"/>
        </Storyboard>
    </Window.Resources>

    <Grid Margin="22">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- ===== Header ===== -->
        <Border Style="{StaticResource Card}" Grid.Row="0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal">
                    <Image Source="/Assets/wolf-logo.png" Width="58" Height="58" VerticalAlignment="Center" Margin="0,0,14,0"/>
                    <StackPanel VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="Whatever IT" FontSize="22" FontWeight="Bold"/>
                        <TextBlock Text="PC Care" FontSize="22" FontWeight="Bold"
                                   Foreground="{StaticResource AccentBrush}" Margin="7,0,0,0"/>
                    </StackPanel>
                    <TextBlock Text="Wolfing down your IT issues" FontStyle="Italic" FontSize="12.5"
                               Foreground="{StaticResource AccentBrush}" Margin="0,2,0,6"/>
                    <TextBlock x:Name="PcLine" Foreground="{StaticResource MutedBrush}" Margin="0,2,0,0" FontSize="13"/>
                    <TextBlock x:Name="OsLine" Foreground="{StaticResource MutedBrush}" FontSize="13"/>
                    <TextBlock x:Name="SpecLine" Foreground="{StaticResource MutedBrush}" FontSize="13"/>
                    </StackPanel>
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <Grid Width="96" Height="96" Margin="0,0,18,0">
                        <Ellipse x:Name="ScoreRing" Stroke="{StaticResource GoodBrush}" StrokeThickness="7" Fill="{StaticResource Card2Brush}"/>
                        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                            <TextBlock x:Name="ScoreText" Text="—" FontSize="28" FontWeight="Bold" HorizontalAlignment="Center"/>
                            <TextBlock Text="health" FontSize="11" Foreground="{StaticResource MutedBrush}" HorizontalAlignment="Center"/>
                        </StackPanel>
                    </Grid>
                    <Button x:Name="ScanButton" Style="{StaticResource PrimaryButton}"
                            Height="64" MinWidth="176" Padding="16,0" Click="OnScan">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <!-- ===== Wolf logo (animated on click) ===== -->
                            <Grid x:Name="WolfLogo" Width="46" Height="46" Margin="0,0,12,0"
                                  RenderTransformOrigin="0.5,0.5">
                                <Grid.RenderTransform>
                                    <TransformGroup>
                                        <ScaleTransform x:Name="WolfScale" ScaleX="1" ScaleY="1"/>
                                        <RotateTransform x:Name="WolfRotate" Angle="0"/>
                                    </TransformGroup>
                                </Grid.RenderTransform>
                                <Ellipse x:Name="WolfScanArc" Width="46" Height="46" Opacity="0"
                                         Stroke="{StaticResource ScanArcBrush}" StrokeThickness="3"
                                         StrokeDashArray="3 2.4" RenderTransformOrigin="0.5,0.5">
                                    <Ellipse.RenderTransform>
                                        <RotateTransform x:Name="ScanArcRotate" Angle="0"/>
                                    </Ellipse.RenderTransform>
                                </Ellipse>
                                <Viewbox Width="38" Height="38">
                                    <Image Width="100" Height="100" Source="/Assets/wolf-logo.png" Stretch="Uniform"/>
                                </Viewbox>
                            </Grid>
                            <TextBlock x:Name="ScanLabel" Text="Scan PC" FontSize="16" FontWeight="Bold"
                                       VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ===== Tabs ===== -->
        <TabControl x:Name="MainTabs" Grid.Row="1" Background="Transparent" BorderThickness="0" Padding="0,14,0,0">

            <!-- Diagnostics -->
            <TabItem Header="Diagnostics">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- Automatic background health check (Pro) -->
                    <Border x:Name="AutoScanCard" Grid.Row="0" Style="{StaticResource Card}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" Margin="0,0,14,0">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="Automatic health monitoring" FontWeight="SemiBold" FontSize="15"/>
                                    <Border CornerRadius="5" Padding="7,2" Margin="10,0,0,0" Background="{StaticResource AccentBrush}">
                                        <TextBlock Text="PRO" FontSize="10" FontWeight="Bold" Foreground="White"/>
                                    </Border>
                                </StackPanel>
                                <TextBlock x:Name="AutoScanStatus" TextWrapping="Wrap" Margin="0,6,0,0" FontSize="12.5"
                                           Foreground="{StaticResource MutedBrush}"/>
                            </StackPanel>
                            <StackPanel Grid.Column="1" VerticalAlignment="Center" HorizontalAlignment="Right">
                                <CheckBox x:Name="AutoScanToggle" Content="Weekly background check"
                                          Foreground="{StaticResource TextBrush}" FontSize="13"
                                          HorizontalAlignment="Right"
                                          Checked="OnAutoScanToggle" Unchecked="OnAutoScanToggle"/>
                                <CheckBox x:Name="CompanionToggle" Content="Desktop companion (Nova the wolf)"
                                          Foreground="{StaticResource TextBrush}" FontSize="13" Margin="0,8,0,0"
                                          HorizontalAlignment="Right"
                                          Checked="OnCompanionToggle" Unchecked="OnCompanionToggle"/>
                                <StackPanel x:Name="CompanionVoicePanel" Orientation="Horizontal"
                                            HorizontalAlignment="Right" Margin="0,6,0,0">
                                    <TextBlock Text="Voice" VerticalAlignment="Center" FontSize="12.5"
                                               Foreground="{StaticResource MutedBrush}" Margin="0,0,8,0"/>
                                    <ComboBox x:Name="CompanionVoiceBox" Width="110" FontSize="12.5"
                                              SelectionChanged="OnCompanionVoiceChanged">
                                        <ComboBoxItem Content="Female"/>
                                        <ComboBoxItem Content="Male"/>
                                    </ComboBox>
                                </StackPanel>
                                <Button x:Name="AutoScanNowButton" Content="Check now" Margin="0,10,0,0"
                                        HorizontalAlignment="Right" Padding="14,6"
                                        Style="{StaticResource GhostButton}" Click="OnAutoScanNow"/>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- "What changed?" since last check (free) -->
                    <Border x:Name="ChangeCard" Grid.Row="1" Style="{StaticResource Card}">
                        <StackPanel>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" Margin="0,0,14,0">
                                    <TextBlock Text="What changed on this PC?" FontWeight="SemiBold" FontSize="15"/>
                                    <TextBlock x:Name="ChangeStatus" TextWrapping="Wrap" Margin="0,6,0,0" FontSize="12.5"
                                               Foreground="{StaticResource MutedBrush}"
                                               Text="Takes a snapshot of your startup programs, installed apps and Windows services. Run it now to save a baseline, then again later to see exactly what has been added or removed – perfect for catching sneaky bloatware and unwanted startup items. Read-only; nothing is changed."/>
                                </StackPanel>
                                <Button x:Name="CheckChangesButton" Grid.Column="1" Content="Check for changes"
                                        VerticalAlignment="Center" Padding="14,7"
                                        Style="{StaticResource PrimaryButton}" Click="OnCheckChanges"/>
                            </Grid>
                            <ItemsControl x:Name="ChangeList" Margin="0,10,0,0">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding}" TextWrapping="Wrap" FontSize="12.5"
                                                   FontFamily="Consolas, monospace" Margin="0,1,0,0"
                                                   Foreground="{StaticResource TextBrush}"/>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>

                    <TextBlock x:Name="ScanStatus" Grid.Row="2" Margin="2,4,0,10"
                               Foreground="{StaticResource MutedBrush}"
                               Text="Click &quot;Scan my PC&quot; to check your computer’s health. Scanning only reads information – it never changes anything."/>
                    <ScrollViewer Grid.Row="3" VerticalScrollBarVisibility="Auto">
                        <ItemsControl x:Name="ResultsList">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Style="{StaticResource Card}">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="6"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <Border Grid.Column="0" CornerRadius="3" Width="6" Margin="0,0,14,0"
                                                    Background="{Binding StatusColor, Converter={StaticResource ToBrush}}"/>
                                            <StackPanel Grid.Column="1">
                                                <TextBlock Text="{Binding Title}" FontWeight="SemiBold" FontSize="15"/>
                                                <TextBlock Text="{Binding Detail}" Foreground="{StaticResource MutedBrush}" Margin="0,3,0,0"/>
                                                <TextBlock Text="{Binding Explanation}" TextWrapping="Wrap" Margin="0,6,0,0" FontSize="12.5"/>
                                            </StackPanel>
                                            <StackPanel Grid.Column="2" VerticalAlignment="Center" HorizontalAlignment="Right">
                                                <Border CornerRadius="6" Padding="10,4" HorizontalAlignment="Right"
                                                        Background="{Binding StatusColor, Converter={StaticResource ToBrush}}">
                                                    <TextBlock Text="{Binding StatusText}" Foreground="White" FontSize="12" FontWeight="SemiBold"/>
                                                </Border>
                                                <Button Content="Fix this" Margin="0,8,0,0" Tag="{Binding RepairId}"
                                                        Style="{StaticResource PrimaryButton}" Padding="12,6" Click="OnFixThis"
                                                        Visibility="{Binding RepairId, Converter={StaticResource NullVis}}"/>
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </Grid>
            </TabItem>

            <!-- Safe Repairs -->
            <TabItem Header="Safe Repairs">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <TextBlock Margin="2,4,0,10" TextWrapping="Wrap" Foreground="{StaticResource MutedBrush}"
                                   Text="These are safe, well-known maintenance actions. Each one explains exactly what it does before you run it. Advanced repairs are part of the Pro plan."/>
                        <ItemsControl x:Name="RepairsList">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Style="{StaticResource Card}">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Grid.Column="0" Margin="0,0,14,0">
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock Text="{Binding Title}" FontWeight="SemiBold" FontSize="15"/>
                                                    <Border CornerRadius="5" Padding="7,2" Margin="10,0,0,0" Background="{StaticResource AccentBrush}"
                                                            Visibility="{Binding ProOnly, Converter={StaticResource BoolVis}}">
                                                        <TextBlock Text="PRO" FontSize="10" FontWeight="Bold" Foreground="White"/>
                                                    </Border>
                                                    <Border CornerRadius="5" Padding="7,2" Margin="8,0,0,0" Background="{StaticResource Card2Brush}"
                                                            Visibility="{Binding RequiresAdmin, Converter={StaticResource BoolVis}}">
                                                        <TextBlock Text="Needs admin" FontSize="10" Foreground="{StaticResource MutedBrush}"/>
                                                    </Border>
                                                </StackPanel>
                                                <TextBlock Text="{Binding Description}" TextWrapping="Wrap" Margin="0,6,0,0" FontSize="12.5"
                                                           Foreground="{StaticResource MutedBrush}"/>
                                            </StackPanel>
                                            <Button Grid.Column="1" Content="Run" VerticalAlignment="Center" Width="96"
                                                    Style="{StaticResource PrimaryButton}" Tag="{Binding Id}" Click="OnRunRepair"/>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- The Rig (Armoury-Crate style dashboard, Whatever IT theme) -->
            <TabItem x:Name="RigTab" Header="The Rig">
                <Grid>
                <ScrollViewer x:Name="RigContent" VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <!-- The Rig dashboard header + live mode chip -->
                        <Border Style="{StaticResource Card}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="THE" FontSize="26" FontWeight="Bold"/>
                                        <TextBlock Text="RIG" FontSize="26" FontWeight="Bold"
                                                   Foreground="{StaticResource AccentBrush}" Margin="8,0,0,0"/>
                                    </StackPanel>
                                    <TextBlock Text="Live CPU and GPU temperatures, clocks, fan speeds and power modes for your machine, plus your Steam game library."
                                               TextWrapping="Wrap" FontSize="13" Foreground="{StaticResource MutedBrush}"
                                               Margin="0,4,0,0" MaxWidth="520" HorizontalAlignment="Left"/>
                                    <TextBlock x:Name="RigAdminHint" TextWrapping="Wrap" FontSize="12"
                                               Foreground="{StaticResource WarnBrush}" Margin="0,8,0,0"
                                               Visibility="Collapsed"
                                               Text="Tip: run Whatever IT PC Care as administrator so it can read live CPU and motherboard temperatures, clocks and fan speeds."/>
                                </StackPanel>
                                <Border Grid.Column="1" VerticalAlignment="Center" CornerRadius="8" Padding="12,8"
                                        Background="{StaticResource Card2Brush}">
                                    <StackPanel>
                                        <TextBlock Text="CURRENT MODE" FontSize="10" FontWeight="SemiBold"
                                                   Foreground="{StaticResource MutedBrush}"/>
                                        <TextBlock x:Name="RigModeChip" Text="Windows" FontSize="18" FontWeight="Bold"
                                                   Foreground="{StaticResource AccentBrush}" Margin="0,2,0,0"/>
                                    </StackPanel>
                                </Border>
                            </Grid>
                        </Border>
                        <!-- Hardware & performance monitoring (live) -->
                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="Hardware &amp; performance" FontSize="16" FontWeight="Bold"/>
                                        <TextBlock Text="Live readouts, refreshed every second." FontSize="12.5"
                                                   Foreground="{StaticResource MutedBrush}" Margin="0,3,0,0"/>
                                    </StackPanel>
                                    <TextBlock x:Name="RigCpuNameText" Grid.Column="1" VerticalAlignment="Center"
                                               FontSize="12" Foreground="{StaticResource MutedBrush}" TextAlignment="Right"/>
                                </Grid>

                                <Grid Margin="0,16,0,0">
                                    <!-- Stat tiles (CPU-temp dial removed) -->
                                    <WrapPanel>
                                        <Border Background="{StaticResource Card2Brush}" CornerRadius="10" Padding="14" Margin="0,0,12,12" Width="150">
                                            <StackPanel>
                                                <TextBlock Text="CPU TEMP" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource MutedBrush}"/>
                                                <TextBlock x:Name="RigCpuTempText" Text="—" FontSize="24" FontWeight="Bold" Margin="0,4,0,0"/>
                                            </StackPanel>
                                        </Border>
                                        <Border Background="{StaticResource Card2Brush}" CornerRadius="10" Padding="14" Margin="0,0,12,12" Width="150">
                                            <StackPanel>
                                                <TextBlock Text="CPU CLOCK" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource MutedBrush}"/>
                                                <TextBlock x:Name="RigCpuClockText" Text="—" FontSize="24" FontWeight="Bold" Margin="0,4,0,0"/>
                                            </StackPanel>
                                        </Border>
                                        <Border Background="{StaticResource Card2Brush}" CornerRadius="10" Padding="14" Margin="0,0,12,12" Width="150">
                                            <StackPanel>
                                                <TextBlock Text="GPU TEMP" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource MutedBrush}"/>
                                                <TextBlock x:Name="RigGpuTempText" Text="—" FontSize="24" FontWeight="Bold" Margin="0,4,0,0"/>
                                            </StackPanel>
                                        </Border>
                                        <Border Background="{StaticResource Card2Brush}" CornerRadius="10" Padding="14" Margin="0,0,12,12" Width="150">
                                            <StackPanel>
                                                <TextBlock Text="GPU CLOCK" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource MutedBrush}"/>
                                                <TextBlock x:Name="RigGpuClockText" Text="—" FontSize="24" FontWeight="Bold" Margin="0,4,0,0"/>
                                            </StackPanel>
                                        </Border>
                                        <Border Background="{StaticResource Card2Brush}" CornerRadius="10" Padding="14" Margin="0,0,12,12" Width="150">
                                            <StackPanel>
                                                <TextBlock Text="FANS (RPM)" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource MutedBrush}"/>
                                                <TextBlock x:Name="RigFanText" Text="—" FontSize="24" FontWeight="Bold" Margin="0,4,0,0"/>
                                            </StackPanel>
                                        </Border>
                                        <Border Background="{StaticResource Card2Brush}" CornerRadius="10" Padding="14" Margin="0,0,12,12" Width="150">
                                            <StackPanel>
                                                <TextBlock Text="CPU VOLTAGE" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource MutedBrush}"/>
                                                <TextBlock x:Name="RigCpuVoltText" Text="—" FontSize="24" FontWeight="Bold" Margin="0,4,0,0"/>
                                            </StackPanel>
                                        </Border>
                                        <Border Background="{StaticResource Card2Brush}" CornerRadius="10" Padding="14" Margin="0,0,12,12" Width="312">
                                            <StackPanel>
                                                <Grid>
                                                    <TextBlock Text="CPU USAGE" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource MutedBrush}"/>
                                                    <TextBlock x:Name="RigCpuLoadText" Text="—" FontSize="13" FontWeight="Bold" HorizontalAlignment="Right"/>
                                                </Grid>
                                                <ProgressBar x:Name="RigCpuLoadBar" Height="8" Margin="0,6,0,0" Minimum="0" Maximum="100"
                                                             Foreground="{StaticResource AccentBrush}" Background="{StaticResource BgBrush}" BorderThickness="0"/>
                                            </StackPanel>
                                        </Border>
                                        <Border Background="{StaticResource Card2Brush}" CornerRadius="10" Padding="14" Margin="0,0,12,12" Width="312">
                                            <StackPanel>
                                                <Grid>
                                                    <TextBlock Text="GPU USAGE" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource MutedBrush}"/>
                                                    <TextBlock x:Name="RigGpuLoadText" Text="—" FontSize="13" FontWeight="Bold" HorizontalAlignment="Right"/>
                                                </Grid>
                                                <ProgressBar x:Name="RigGpuLoadBar" Height="8" Margin="0,6,0,0" Minimum="0" Maximum="100"
                                                             Foreground="{StaticResource AccentBrush}" Background="{StaticResource BgBrush}" BorderThickness="0"/>
                                            </StackPanel>
                                        </Border>
                                        <Border Background="{StaticResource Card2Brush}" CornerRadius="10" Padding="14" Margin="0,0,12,12" Width="312">
                                            <StackPanel>
                                                <Grid>
                                                    <TextBlock Text="MEMORY (RAM)" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource MutedBrush}"/>
                                                    <TextBlock x:Name="RigRamText" Text="—" FontSize="13" FontWeight="Bold" HorizontalAlignment="Right"/>
                                                </Grid>
                                                <ProgressBar x:Name="RigRamBar" Height="8" Margin="0,6,0,0" Minimum="0" Maximum="100"
                                                             Foreground="{StaticResource AccentBrush}" Background="{StaticResource BgBrush}" BorderThickness="0"/>
                                            </StackPanel>
                                        </Border>
                                        <Border Background="{StaticResource Card2Brush}" CornerRadius="10" Padding="14" Margin="0,0,12,12" Width="312">
                                            <StackPanel>
                                                <Grid>
                                                    <TextBlock Text="STORAGE (SYSTEM DRIVE)" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource MutedBrush}"/>
                                                    <TextBlock x:Name="RigStorageText" Text="—" FontSize="13" FontWeight="Bold" HorizontalAlignment="Right"/>
                                                </Grid>
                                                <ProgressBar x:Name="RigStorageBar" Height="8" Margin="0,6,0,0" Minimum="0" Maximum="100"
                                                             Foreground="{StaticResource AccentBrush}" Background="{StaticResource BgBrush}" BorderThickness="0"/>
                                            </StackPanel>
                                        </Border>
                                    </WrapPanel>
                                </Grid>
                            </StackPanel>
                        </Border>

                        <!-- Live performance graphs + safe stress test -->
                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="Live graphs &amp; stress test" FontSize="16" FontWeight="Bold"/>
                                        <TextBlock TextWrapping="Wrap" FontSize="12.5" Foreground="{StaticResource MutedBrush}" Margin="0,3,0,0"
                                                   MaxWidth="520" HorizontalAlignment="Left"
                                                   Text="Watch temperatures and CPU load over time. The stress test safely pushes every CPU core to 100% for 30 seconds so you can see how hot it gets and whether cooling holds up - it stops itself automatically if things get too hot."/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                        <Button x:Name="RunStressButton" Content="Run stress test" Padding="14,7"
                                                Style="{StaticResource PrimaryButton}" Click="OnRunStress"/>
                                        <Button x:Name="StopStressButton" Content="Stop" Padding="14,6" Margin="0,8,0,0"
                                                IsEnabled="False" Style="{StaticResource GhostButton}" Click="OnStopStress"/>
                                    </StackPanel>
                                </Grid>

                                <!-- 0-100 scale graph area -->
                                <Border Background="{StaticResource Card2Brush}" CornerRadius="10" Padding="6" Margin="0,14,0,0" Height="170">
                                    <Canvas x:Name="RigGraphCanvas" ClipToBounds="True">
                                        <Polyline x:Name="RigCpuTempLine" Stroke="{StaticResource AccentBrush}" StrokeThickness="2"/>
                                        <Polyline x:Name="RigGpuTempLine" Stroke="#FF4DA3FF" StrokeThickness="2"/>
                                        <Polyline x:Name="RigCpuLoadLine" Stroke="#FF34C759" StrokeThickness="1.5" StrokeDashArray="3 2"/>
                                    </Canvas>
                                </Border>
                                <WrapPanel Margin="0,8,0,0">
                                    <StackPanel Orientation="Horizontal" Margin="0,0,16,0">
                                        <Border Width="14" Height="4" CornerRadius="2" VerticalAlignment="Center" Background="{StaticResource AccentBrush}"/>
                                        <TextBlock Text="CPU temp (°C)" FontSize="11.5" Margin="6,0,0,0" Foreground="{StaticResource MutedBrush}"/>
                                    </StackPanel>
                                    <StackPanel Orientation="Horizontal" Margin="0,0,16,0">
                                        <Border Width="14" Height="4" CornerRadius="2" VerticalAlignment="Center" Background="#FF4DA3FF"/>
                                        <TextBlock Text="GPU temp (°C)" FontSize="11.5" Margin="6,0,0,0" Foreground="{StaticResource MutedBrush}"/>
                                    </StackPanel>
                                    <StackPanel Orientation="Horizontal">
                                        <Border Width="14" Height="4" CornerRadius="2" VerticalAlignment="Center" Background="#FF34C759"/>
                                        <TextBlock Text="CPU load (%)" FontSize="11.5" Margin="6,0,0,0" Foreground="{StaticResource MutedBrush}"/>
                                    </StackPanel>
                                </WrapPanel>
                                <TextBlock x:Name="RigStressStatus" TextWrapping="Wrap" FontSize="12.5" Margin="0,12,0,0"
                                           Foreground="{StaticResource MutedBrush}"/>
                                <TextBlock x:Name="RigStressVerdict" TextWrapping="Wrap" FontSize="13" FontWeight="SemiBold" Margin="0,6,0,0"/>
                            </StackPanel>
                        </Border>

                        <!-- Operating & fan modes -->
                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <TextBlock Text="Operating &amp; fan modes" FontSize="16" FontWeight="Bold"/>
                                <TextBlock TextWrapping="Wrap" FontSize="12.5" Foreground="{StaticResource MutedBrush}" Margin="0,3,0,10"
                                           Text="Switch the Windows power profile to balance quiet running, battery life and full performance. (Deep fan-curve control is tied to your PC maker's own utility; this changes the Windows power plan, which every PC supports.)"/>
                                <WrapPanel>
                                    <Button Content="🤫  Silent" Tag="silent" Click="OnRigMode" Style="{StaticResource GhostButton}" Margin="0,0,10,10"/>
                                    <Button Content="⚖  Balanced" Tag="balanced" Click="OnRigMode" Style="{StaticResource GhostButton}" Margin="0,0,10,10"/>
                                    <Button Content="🚀  Performance" Tag="performance" Click="OnRigMode" Style="{StaticResource GhostButton}" Margin="0,0,10,10"/>
                                    <Button Content="🔥  Turbo" Tag="turbo" Click="OnRigMode" Style="{StaticResource PrimaryButton}" Margin="0,0,10,10"/>
                                    <Button Content="🎛  Manual" Tag="manual" Click="OnRigMode" Style="{StaticResource GhostButton}" Margin="0,0,10,10"/>
                                    <Button Content="⊞  Windows" Tag="windows" Click="OnRigMode" Style="{StaticResource GhostButton}" Margin="0,0,10,10"/>
                                </WrapPanel>
                                <TextBlock x:Name="RigModeStatus" FontSize="12.5" Foreground="{StaticResource AccentBrush}" Margin="0,2,0,0"/>
                            </StackPanel>
                        </Border>

                        <!-- One-click Game Mode -->
                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0" Margin="0,0,14,0">
                                        <TextBlock Text="Game Mode" FontSize="16" FontWeight="Bold"/>
                                        <TextBlock TextWrapping="Wrap" FontSize="12.5" Foreground="{StaticResource MutedBrush}" Margin="0,3,0,0"
                                                   MaxWidth="520" HorizontalAlignment="Left"
                                                   Text="One click pauses common background apps (cloud sync, chat, music, updaters) and switches Windows to high performance, giving your game the whole machine. It is fully reversible - turning it off un-pauses exactly what it paused and restores your power plan. It never closes anything, so nothing is lost."/>
                                    </StackPanel>
                                    <Button x:Name="GameModeButton" Grid.Column="1" Content="🎮  Turn Game Mode on"
                                            VerticalAlignment="Center" Padding="16,8"
                                            Style="{StaticResource PrimaryButton}" Click="OnGameModeToggle"/>
                                </Grid>
                                <TextBlock x:Name="RigGameModeStatus" TextWrapping="Wrap" FontSize="12.5" Margin="0,10,0,0"
                                           Foreground="{StaticResource AccentBrush}"/>
                            </StackPanel>
                        </Border>

                        <!-- Aura-style lighting -->
                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <TextBlock Text="Lighting (Aura style)" FontSize="16" FontWeight="Bold"/>
                                <TextBlock TextWrapping="Wrap" FontSize="12.5" Foreground="{StaticResource MutedBrush}" Margin="0,3,0,10"
                                           Text="Preview of the Whatever IT lighting palette. Live RGB sync to motherboards, GPUs and peripherals is driven by each device maker's own lighting SDK - this panel shows the brand look; full device sync is on the roadmap."/>
                                <StackPanel Orientation="Horizontal">
                                    <Border Width="46" Height="46" CornerRadius="8" Margin="0,0,10,0" Background="{StaticResource AccentBrush}"/>
                                    <Border Width="46" Height="46" CornerRadius="8" Margin="0,0,10,0" Background="{StaticResource WolfBrush}"/>
                                    <Border Width="46" Height="46" CornerRadius="8" Margin="0,0,10,0" Background="{StaticResource ScanArcBrush}"/>
                                    <Border Width="46" Height="46" CornerRadius="8" Margin="0,0,10,0" Background="{StaticResource WolfEyeBrush}"/>
                                    <Border Width="46" Height="46" CornerRadius="8" Margin="0,0,10,0" Background="{StaticResource WolfDarkBrush}"/>
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <!-- Drivers & BIOS / maintenance -->
                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <TextBlock Text="Drivers &amp; BIOS" FontSize="16" FontWeight="Bold"/>
                                <TextBlock TextWrapping="Wrap" FontSize="12.5" Foreground="{StaticResource MutedBrush}" Margin="0,3,0,10"
                                           Text="Keep the system current. These open the official, safe tools - Whatever IT never flashes a BIOS automatically, because a bad flash can brick a board; it points you to the maker's verified download instead."/>
                                <WrapPanel>
                                    <Button Content="Check Windows Update" Click="OnRigWindowsUpdate" Style="{StaticResource PrimaryButton}" Margin="0,0,10,10"/>
                                    <Button Content="Open Device Manager" Click="OnRigDeviceManager" Style="{StaticResource GhostButton}" Margin="0,0,10,10"/>
                                    <Button Content="ASUS driver &amp; BIOS downloads" Click="OnRigAsusSupport" Style="{StaticResource GhostButton}" Margin="0,0,10,10"/>
                                </WrapPanel>
                            </StackPanel>
                        </Border>

                        <!-- Driver awareness (read-only version check) -->
                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0" Margin="0,0,14,0">
                                        <TextBlock Text="Driver check" FontSize="16" FontWeight="Bold"/>
                                        <TextBlock x:Name="RigDriversStatus" TextWrapping="Wrap" FontSize="12.5" Foreground="{StaticResource MutedBrush}" Margin="0,3,0,0"
                                                   MaxWidth="520" HorizontalAlignment="Left"
                                                   Text="Reads the version and date of your graphics, network and storage drivers and flags any that are getting old. It does NOT download or install anything - if one looks dated, use the official links above to get the maker's latest."/>
                                    </StackPanel>
                                    <Button Grid.Column="1" Content="Check my drivers" VerticalAlignment="Center"
                                            Padding="14,7" Style="{StaticResource GhostButton}" Click="OnScanDrivers"/>
                                </Grid>
                                <ItemsControl x:Name="RigDriversList" Margin="0,12,0,0">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Background="{StaticResource Card2Brush}" CornerRadius="10" Padding="12" Margin="0,0,0,8">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>
                                                    <StackPanel Grid.Column="0" Margin="0,0,12,0">
                                                        <TextBlock Text="{Binding Device}" FontWeight="SemiBold" FontSize="13.5" TextWrapping="Wrap"/>
                                                        <TextBlock FontSize="12" Foreground="{StaticResource MutedBrush}" Margin="0,3,0,0">
                                                            <Run Text="{Binding Category, Mode=OneWay}"/><Run Text="  •  v"/><Run Text="{Binding Version, Mode=OneWay}"/><Run Text="  •  "/><Run Text="{Binding DateText, Mode=OneWay}"/><Run Text="  ("/><Run Text="{Binding AgeText, Mode=OneWay}"/><Run Text=")"/>
                                                        </TextBlock>
                                                        <TextBlock Text="{Binding Advice}" FontSize="12" TextWrapping="Wrap" Margin="0,4,0,0" Foreground="{StaticResource TextBrush}"/>
                                                    </StackPanel>
                                                    <Border Grid.Column="1" VerticalAlignment="Center" CornerRadius="6" Padding="10,4"
                                                            Background="{StaticResource BgBrush}">
                                                        <TextBlock FontSize="11" FontWeight="SemiBold"
                                                                   Text="{Binding Category}" Foreground="{StaticResource AccentBrush}"/>
                                                    </Border>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </Border>

                        <!-- Scenario profiles & peripherals (overview) -->
                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <TextBlock Text="Scenario profiles &amp; peripherals" FontSize="16" FontWeight="Bold"/>
                                <TextBlock TextWrapping="Wrap" FontSize="12.5" Foreground="{StaticResource MutedBrush}" Margin="0,3,0,0"
                                           Text="Scenario profiles can switch the performance mode above automatically when a chosen game launches. Per-key macros, mouse DPI and OLED / AniMe displays depend on the specific keyboard, mouse or laptop and its maker's driver - supported devices will plug in here."/>
                            </StackPanel>
                        </Border>

                        <!-- Game library & deals -->
                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="Game library" FontSize="16" FontWeight="Bold"/>
                                        <TextBlock x:Name="RigGamesStatus" FontSize="12.5" Foreground="{StaticResource MutedBrush}" Margin="0,3,0,0"
                                                   Text="Your installed Steam games appear here so you can launch them in one click."/>
                                    </StackPanel>
                                    <Button Grid.Column="1" Content="Scan for games" VerticalAlignment="Center"
                                            Click="OnScanGames" Style="{StaticResource GhostButton}"/>
                                </Grid>
                                <ItemsControl x:Name="RigGamesList" Margin="0,12,0,0">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <WrapPanel/>
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Background="{StaticResource Card2Brush}" CornerRadius="10" Padding="14" Margin="0,0,12,12" Width="214">
                                                <StackPanel>
                                                    <TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="13.5"
                                                               TextTrimming="CharacterEllipsis"/>
                                                    <Button Content="▶  Play" Margin="0,10,0,0" HorizontalAlignment="Left"
                                                            Tag="{Binding Launch}" Click="OnLaunchGame"
                                                            Style="{StaticResource PrimaryButton}" Padding="14,6"/>
                                                </StackPanel>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>

                <!-- Pro-only lock. Shown over The Rig when the user is not on the
                     Pro plan; hidden the moment they upgrade. -->
                <Border x:Name="RigLockOverlay" Visibility="Collapsed"
                        Background="{StaticResource BgBrush}">
                    <Border Style="{StaticResource Card}" MaxWidth="460" Padding="34"
                            HorizontalAlignment="Center" VerticalAlignment="Center">
                        <StackPanel HorizontalAlignment="Center">
                            <TextBlock Text="🔒" FontSize="40" HorizontalAlignment="Center"/>
                            <TextBlock Text="The Rig is a Pro feature" FontSize="20" FontWeight="Bold"
                                       Foreground="White" HorizontalAlignment="Center" Margin="0,10,0,0"/>
                            <TextBlock TextWrapping="Wrap" TextAlignment="Center" FontSize="13"
                                       Foreground="{StaticResource MutedBrush}" Margin="0,10,0,0"
                                       Text="Live CPU / GPU temperature, clocks, fan speeds, power &amp; fan modes and the gaming dashboard are included with Whatever IT PC Care Pro. Upgrade to unlock The Rig."/>
                            <Button Content="Upgrade to Pro" Click="OnGetPro" Style="{StaticResource PrimaryButton}"
                                    HorizontalAlignment="Center" Margin="0,18,0,0"/>
                        </StackPanel>
                    </Border>
                </Border>
                </Grid>
            </TabItem>

            <!-- Plan & Billing -->
            <TabItem x:Name="PlanTab" Header="Plan &amp; Billing">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel MaxWidth="640" HorizontalAlignment="Left">
                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <TextBlock Text="Your plan" FontSize="16" FontWeight="Bold"/>
                                <TextBlock x:Name="LicenseStatus" Margin="0,8,0,0" TextWrapping="Wrap"
                                           Foreground="{StaticResource MutedBrush}"/>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource Card}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" Margin="0,0,14,0">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="Basic" FontSize="16" FontWeight="Bold"/>
                                        <TextBlock Text="R65 / month" FontSize="14" FontWeight="SemiBold"
                                                   Foreground="{StaticResource AccentBrush}" Margin="12,2,0,0"/>
                                    </StackPanel>
                                    <TextBlock Margin="0,6,0,0" TextWrapping="Wrap" FontSize="12.5"
                                               Foreground="{StaticResource MutedBrush}"
                                               Text="Unlocks the one-click safe repairs – clear temporary files, empty the Recycle Bin and refresh your network – on top of the free diagnostics."/>
                                </StackPanel>
                                <Button x:Name="BasicActionButton" Grid.Column="1" Content="Get Basic" Width="130"
                                        VerticalAlignment="Center" Style="{StaticResource PrimaryButton}" Click="OnGetBasic"/>
                            </Grid>
                        </Border>

                        <Border Style="{StaticResource Card}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" Margin="0,0,14,0">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="Pro" FontSize="16" FontWeight="Bold"/>
                                        <TextBlock Text="R99 / month" FontSize="14" FontWeight="SemiBold"
                                                   Foreground="{StaticResource AccentBrush}" Margin="12,2,0,0"/>
                                    </StackPanel>
                                    <TextBlock Margin="0,6,0,0" TextWrapping="Wrap" FontSize="12.5"
                                               Foreground="{StaticResource MutedBrush}"
                                               Text="Everything in Basic, plus the advanced repairs: repair Windows system files (SFC), repair the Windows image (DISM) and fix stuck Windows Update, plus automatic weekly background health checks with tray alerts."/>
                                </StackPanel>
                                <Button x:Name="ProActionButton" Grid.Column="1" Content="Get Pro" Width="130"
                                        VerticalAlignment="Center" Style="{StaticResource PrimaryButton}" Click="OnGetPro"/>
                            </Grid>
                        </Border>

                        <TextBlock Margin="4,2,0,0" TextWrapping="Wrap" FontSize="11.5"
                                   Foreground="{StaticResource MutedBrush}"
                                   Text="Plans are billed monthly through our secure payment partner. Your plan activates automatically the moment payment is confirmed – no key to type, no email to wait for. If a monthly payment is missed, the plan simply pauses until you renew."/>

                        <Expander Header="Already have a licence key?" Margin="0,12,0,0"
                                  Foreground="{StaticResource MutedBrush}">
                            <Border Style="{StaticResource Card}">
                                <StackPanel>
                                    <TextBlock Text="Licensed to (name)" FontSize="12" Foreground="{StaticResource MutedBrush}"/>
                                    <TextBox x:Name="NameBox" Margin="0,4,0,10" Padding="8" FontSize="13"
                                             Background="{StaticResource Card2Brush}" Foreground="{StaticResource TextBrush}" BorderThickness="0"/>
                                    <TextBlock Text="Licence key" FontSize="12" Foreground="{StaticResource MutedBrush}"/>
                                    <TextBox x:Name="KeyBox" Margin="0,4,0,12" Padding="8" FontSize="13"
                                             Background="{StaticResource Card2Brush}" Foreground="{StaticResource TextBrush}" BorderThickness="0"/>
                                    <StackPanel Orientation="Horizontal">
                                        <Button Content="Activate" Style="{StaticResource PrimaryButton}" Click="OnActivate"/>
                                        <Button Content="Remove licence" Style="{StaticResource GhostButton}" Margin="10,0,0,0" Click="OnDeactivate"/>
                                    </StackPanel>
                                </StackPanel>
                            </Border>
                        </Expander>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- Help -->
            <TabItem Header="Help &amp; Contact">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel MaxWidth="680" HorizontalAlignment="Left">
                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <TextBlock Text="What this tool does" FontSize="16" FontWeight="Bold"/>
                                <TextBlock Margin="0,8,0,0" TextWrapping="Wrap"
                                   Text="Whatever IT PC Care checks your computer’s health, explains in plain language what it finds, and offers safe fixes you can run yourself. It is an honest diagnostic tool – it will not pretend to magically make a PC faster."/>
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <TextBlock Text="When something needs a technician" FontSize="16" FontWeight="Bold"/>
                                <TextBlock Margin="0,8,0,4" TextWrapping="Wrap"
                                   Text="Some problems – failing hardware, stubborn malware, or repairs that carry risk – are safer in expert hands. If a scan flags something beyond a safe self-fix, give Whatever IT a call – a technician picks up, not a call centre."/>
                                <TextBlock Margin="0,2,0,12" FontSize="20" FontWeight="Bold"
                                           Foreground="{StaticResource AccentBrush}" Text="010 025 0564"/>
                                <StackPanel Orientation="Horizontal">
                                    <Button Content="📞  Call Whatever IT" Style="{StaticResource PrimaryButton}" Click="OnContact"/>
                                    <Button Content="Visit our website" Style="{StaticResource GhostButton}" Margin="10,0,0,0" Click="OnWebsite"/>
                                </StackPanel>
                            </StackPanel>
                        </Border>
                        <TextBlock x:Name="VersionLine" Foreground="{StaticResource MutedBrush}" FontSize="12" Margin="4,4,0,0"/>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>
        </TabControl>
    </Grid>
</Window>
