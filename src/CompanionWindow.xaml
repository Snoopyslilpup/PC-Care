<Window x:Class="WhateverITPCCare.CompanionWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Wolf" WindowStyle="None" AllowsTransparency="True"
        Background="Transparent" ShowInTaskbar="False" Topmost="True"
        ResizeMode="NoResize" SizeToContent="Manual"
        Width="240" Height="340" Left="80" Top="80">

    <!-- The whole window is click-through-free: only the wolf graphic and the
         bubble are hit-testable, the rest of the canvas is transparent. -->
    <Grid x:Name="Root">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>     <!-- speech bubble floats here -->
            <RowDefinition Height="Auto"/>  <!-- wolf sits at the bottom -->
        </Grid.RowDefinitions>

        <!-- Speech bubble -->
        <Border x:Name="Bubble" Grid.Row="0" VerticalAlignment="Bottom" HorizontalAlignment="Center"
                Background="#FF141A24" CornerRadius="12" Padding="12,9" Margin="0,0,0,6"
                MaxWidth="230" Visibility="Collapsed" IsHitTestVisible="False">
            <Border.Effect>
                <DropShadowEffect BlurRadius="14" ShadowDepth="0" Color="#FF000000" Opacity="0.6"/>
            </Border.Effect>
            <TextBlock x:Name="BubbleText" Foreground="#FFF1F4FA" FontSize="13" FontWeight="SemiBold"
                       FontFamily="Segoe UI" TextWrapping="Wrap" Text=""/>
        </Border>

        <!-- Wolf sprite -->
        <Grid Grid.Row="1" HorizontalAlignment="Center" VerticalAlignment="Bottom">
            <Image x:Name="WolfImage" Source="/Assets/wolf-companion.png" Stretch="Uniform"
                   Width="120" RenderTransformOrigin="0.5,1.0" Cursor="Hand"
                   MouseLeftButtonDown="OnWolfMouseDown"
                   MouseLeftButtonUp="OnWolfMouseUp"
                   MouseMove="OnWolfMouseMove"
                   MouseRightButtonUp="OnWolfRightClick">
                <Image.RenderTransform>
                    <TransformGroup>
                        <!-- facing (ScaleX flips) + overall size -->
                        <ScaleTransform x:Name="Facing" ScaleX="1" ScaleY="1"/>
                        <!-- little squash/pulse on reactions -->
                        <ScaleTransform x:Name="Pulse" ScaleX="1" ScaleY="1" CenterX="60" CenterY="150"/>
                        <!-- walking bob + tilt -->
                        <TranslateTransform x:Name="Bob" X="0" Y="0"/>
                        <RotateTransform x:Name="Tilt" Angle="0" CenterX="60" CenterY="150"/>
                    </TransformGroup>
                </Image.RenderTransform>
                <Image.Effect>
                    <!-- mood glow: colour animated from code-behind -->
                    <DropShadowEffect x:Name="MoodGlow" BlurRadius="26" ShadowDepth="0"
                                      Color="#FFE8902B" Opacity="0"/>
                </Image.Effect>
            </Image>

            <!-- "Zzz" shown while sleeping -->
            <TextBlock x:Name="SleepZ" Text="z z Z" Foreground="#FF9FF6FF" FontSize="18"
                       FontWeight="Bold" FontFamily="Segoe UI" Visibility="Collapsed"
                       HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,8,10,0"
                       IsHitTestVisible="False"/>
        </Grid>
    </Grid>
</Window>
